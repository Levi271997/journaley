# From your Supabase project: the "Connect" button -> App Frameworks -> Next.js.
# Copy this file to .env.local and fill in the two values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The public key. Newer projects call this the publishable key; older ones the
# anon key. Either variable name works — never use the service_role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
